# ════════════════════════════════════════════════════════════════════════════
# DOCUMENT 5: heritage record of the town hall (Mérimée PA00118150, historic
#     monument, partially listed on 29 April 1991; online since 1993-12-03)
#
# Three references at two scales: the building, dated by the record, and
#     its façades and roofs, the protected parts that the LoD2 wall and roof
#     surfaces represent.
# ════════════════════════════════════════════════════════════════════════════

data:document_5 a owl:NamedIndividual, doc:Document ;
    doc:Document.title "Hôtel de ville"@fr ;
    doc:Document.uri "https://pop.culture.gouv.fr/notice/merimee/PA00118150"^^xsd:anyURI ;
    core:AbstractFeatureWithLifespan.creationDate "1993-12-03T00:00:00"^^xsd:dateTime ;
    doc:Document.tag data:tag_townHall, data:tag_heritage, data:tag_villeurbanne ;
    dct:publisher "Ministère de la Culture (POP, base Mérimée)" ;
    rdfs:comment "Record PA00118150 of the Mérimée database: town hall by Robert Giroud, dated 1930, inaugurated in 1934, part of the Cité des Gratte-ciel; façades and roofs, main staircase, halls and corridors of the first and second floors, wedding hall and a fireplace listed as a historic monument on 29 April 1991. Creation date: date the record was put online."@en ;
    doc:Document.referringTo data:reference_9 , data:reference_10 , data:reference_11 .

