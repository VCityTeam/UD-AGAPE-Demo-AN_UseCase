    doc:Reference.purposeType      data:purposeType_aerialView ;
    doc:Reference.referenceText    "Vue aérienne de la cité des Gratte-Ciel en 1936" ;
    doc:Reference.referringTo      data:BU_69266BO56_0 .

data:reference_2 a owl:NamedIndividual, doc:Reference ;
    doc:Reference.referringDate    "2020-03-11T15:47:26"^^xsd:dateTime ;
    doc:Reference.coveragePeriod   data:interval_1936 ;
