@prefix core:  <https://dataset-dl.liris.cnrs.fr/rdf-owl-urban-data-ontologies/Ontologies/CityOWL/CWA/3.0/core#> .
@prefix bldg:  <https://dataset-dl.liris.cnrs.fr/rdf-owl-urban-data-ontologies/Ontologies/CityOWL/CWA/3.0/building#> .
@prefix doc:   <https://dataset-dl.liris.cnrs.fr/rdf-owl-urban-data-ontologies/Ontologies/Document/3.0/document#> .
@prefix time:  <http://www.w3.org/2006/time#> .
@prefix data:  <https://raw.githubusercontent.com/VCityTeam/UD-Graph/master/Datasets/GratteCiel_2018_split_v3#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix con:   <https://dataset-dl.liris.cnrs.fr/rdf-owl-urban-data-ontologies/Ontologies/CityOWL/CWA/3.0/construction#> .
@prefix rico:  <https://www.ica.org/standards/RiC/ontology#> .

# Gratte-Ciel (Villeurbanne) city objects and the documents that describe
#     them, expressed with CityOWL CWA 3.0 (ontologies/CityOWL/CWA/3.0/) and
#     its Document module.
#
# City objects: the individual IRIs (data:) are those of the Gratte-Ciel 3D
#     city model (UD-Graph dataset GratteCiel_2018_split_v3), so documents
#     remain linkable to its LoD2 geometry.
#
# Documents: every document, URL, title, author, licence and date comes
#     from its source, checked on 2026-10-12:
#     - Wikimedia Commons file pages and their metadata;
#     - Numelyo, digital library of the Bibliothèque municipale de Lyon;
#     - POP, heritage platform of the French Ministry of Culture (Mérimée).
#     References (doc:Reference) are this dataset's own annotations; their
#     assertion dates are the dates those annotations were made.

<https://raw.githubusercontent.com/VCityTeam/UD-AGAPE-Demo-AN_UseCase/master/data/gratteciel/gratteciel-documents.ttl>
    a owl:Ontology ;
    owl:imports
        <http://www.w3.org/2004/02/skos/core> ,
        <https://dataset-dl.liris.cnrs.fr/rdf-owl-urban-data-ontologies/Ontologies/CityOWL/CWA/3.0/core> ,
        <https://dataset-dl.liris.cnrs.fr/rdf-owl-urban-data-ontologies/Ontologies/CityOWL/CWA/3.0/building> ,
        <https://dataset-dl.liris.cnrs.fr/rdf-owl-urban-data-ontologies/Ontologies/Document/3.0/document> .

# ════════════════════════════════════════════════════════════════════════════
# PURPOSE-TYPE VOCABULARY
# ════════════════════════════════════════════════════════════════════════════

data:purposeTypeScheme a owl:NamedIndividual, skos:ConceptScheme ;
    skos:prefLabel "Document Purpose Types"@en .

data:purposeType_aerialView a owl:NamedIndividual, doc:PurposeTypeValue ;
    skos:prefLabel "Aerial View"@en , "Vue aérienne"@fr ;
    skos:inScheme data:purposeTypeScheme .

data:purposeType_constructionPhotograph a owl:NamedIndividual, doc:PurposeTypeValue ;
    skos:prefLabel "Construction Photograph"@en , "Photographie de chantier"@fr ;
    skos:inScheme data:purposeTypeScheme .

data:purposeType_heritageRecord a owl:NamedIndividual, doc:PurposeTypeValue ;
    skos:prefLabel "Heritage Inventory Record"@en , "Notice d'inventaire patrimonial"@fr ;
    skos:inScheme data:purposeTypeScheme .

data:purposeType_streetView a owl:NamedIndividual, doc:PurposeTypeValue ;
    skos:prefLabel "Street View"@en , "Vue depuis la rue"@fr ;
    skos:inScheme data:purposeTypeScheme .

data:purposeType_architecturalDrawing a owl:NamedIndividual, doc:PurposeTypeValue ;
    skos:prefLabel "Architectural Drawing"@en , "Dessin d'architecture"@fr ;
    skos:inScheme data:purposeTypeScheme .

data:purposeType_interiorView a owl:NamedIndividual, doc:PurposeTypeValue ;
    skos:prefLabel "Interior View"@en , "Vue intérieure"@fr ;
    skos:inScheme data:purposeTypeScheme .

# ════════════════════════════════════════════════════════════════════════════
# TAG INDIVIDUALS (doc:Tag)
# doc:Tag.count = number of documents carrying the tag.
# ════════════════════════════════════════════════════════════════════════════

data:tag_gratteCiel a owl:NamedIndividual, doc:Tag ;
    doc:Tag.text "Gratte-ciel"@fr ;
    doc:Tag.count 4 .

data:tag_villeurbanne a owl:NamedIndividual, doc:Tag ;
    doc:Tag.text "Villeurbanne"@fr ;
    doc:Tag.count 10 .

data:tag_aerialView a owl:NamedIndividual, doc:Tag ;
    doc:Tag.text "Aerial view"@en ;
    doc:Tag.count 1 .

data:tag_construction a owl:NamedIndividual, doc:Tag ;
    doc:Tag.text "Construction"@en ;
    doc:Tag.count 1 .

data:tag_heritage a owl:NamedIndividual, doc:Tag ;
    doc:Tag.text "Heritage"@en ;
    doc:Tag.count 2 .

data:tag_streetView a owl:NamedIndividual, doc:Tag ;
    doc:Tag.text "Street view"@en ;
    doc:Tag.count 4 .

data:tag_townHall a owl:NamedIndividual, doc:Tag ;
    doc:Tag.text "Hôtel de ville"@fr ;
    doc:Tag.count 6 .

data:tag_architecturalDrawing a owl:NamedIndividual, doc:Tag ;
    doc:Tag.text "Architectural drawing"@en ;
    doc:Tag.count 1 .

data:tag_interior a owl:NamedIndividual, doc:Tag ;
    doc:Tag.text "Interior"@en ;
    doc:Tag.count 1 .

# ════════════════════════════════════════════════════════════════════════════
# CITY OBJECTS (CityOWL CWA 3.0)
#
# The district is dated from the Mérimée record of the Cité des Gratte-Ciel
#     (ACR0000160, dating "1930 ; 1931"). No per-building dates are given:
#     the sources do not date the buildings individually.
# ════════════════════════════════════════════════════════════════════════════

# District scale
data:GratteCielDistrict a owl:NamedIndividual, core:AbstractFeatureWithLifespan ;
    skos:prefLabel "Cité des Gratte-Ciel district"@en ,
                   "Cité des Gratte-Ciel"@fr ;
    core:AbstractFeatureWithLifespan.creationDate "1930-01-01T00:00:00"^^xsd:dateTime ;
    rdfs:comment "Year only: the Mérimée record ACR0000160 dates the Cité des Gratte-Ciel 1930–1931."@en ;
    rdfs:seeAlso "https://pop.culture.gouv.fr/notice/merimee/ACR0000160"^^xsd:anyURI .

# The town hall (Hôtel de ville), part of the Cité des Gratte-Ciel according
#     to its Mérimée record PA00118150: architect Robert Giroud, dated 1930,
#     inaugurated in 1934, partially listed as a historic monument on
#     29 April 1991 (façades and roofs among the protected parts).
# Identified in the 3D city model as the building whose footprint contains
#     the record's coordinates (45.76652 N, 4.87961 E); its 64 m height
#     matches the belfry tower the record describes.
data:BU_69266BO55_0 a owl:NamedIndividual, bldg:Building ;
    skos:prefLabel "BU_69266BO55_0" ;
    rdfs:label "Hôtel de ville de Villeurbanne"@fr , "Villeurbanne town hall"@en ;
    core:AbstractFeatureWithLifespan.creationDate "1934-01-01T00:00:00"^^xsd:dateTime ;
    rdfs:comment "Year only: inaugurated in 1934 according to the Mérimée record PA00118150, which dates the building 1930."@en ;
    rdfs:seeAlso "https://pop.culture.gouv.fr/notice/merimee/PA00118150"^^xsd:anyURI ;
    core:AbstractSpace.boundary data:RoofSurface_60, data:WallSurface_60 .

# Surface scale: the town hall's LoD2 wall and roof surfaces, which the
#     protection of its façades and roofs refers to
data:WallSurface_60 a owl:NamedIndividual, con:WallSurface ;
    skos:prefLabel "Façades de l'hôtel de ville (surface murale LoD2)"@fr , "Town hall façades (LoD2 wall surface)"@en .

data:RoofSurface_60 a owl:NamedIndividual, con:RoofSurface ;
    skos:prefLabel "Toitures de l'hôtel de ville (surface de toit LoD2)"@fr , "Town hall roofs (LoD2 roof surface)"@en .

# Building scale, with their LoD2 roof and wall surfaces in the 3D model
data:BU_69266BO56_0 a owl:NamedIndividual, bldg:Building ;
    skos:prefLabel "BU_69266BO56_0" ;
    core:AbstractSpace.boundary data:RoofSurface_165, data:WallSurface_165 .

data:BU_69266BO56_1 a owl:NamedIndividual, bldg:Building ;
    skos:prefLabel "BU_69266BO56_1" ;
    core:AbstractSpace.boundary data:RoofSurface_166, data:WallSurface_166 .

data:BU_69266BO56_2 a owl:NamedIndividual, bldg:Building ;
    skos:prefLabel "BU_69266BO56_2" ;
    core:AbstractSpace.boundary data:RoofSurface_167, data:WallSurface_167 .

data:BU_69266BO56_3 a owl:NamedIndividual, bldg:Building ;
    skos:prefLabel "BU_69266BO56_3" ;
    core:AbstractSpace.boundary data:RoofSurface_168, data:WallSurface_168 .

# ════════════════════════════════════════════════════════════════════════════
# OWL-TIME INTERVALS: periods depicted or described by the documents
# ════════════════════════════════════════════════════════════════════════════

# The 1936 aerial photograph
data:interval_1936 a owl:NamedIndividual, time:Interval ;
    time:hasBeginning data:instant_1936 ;
    time:hasEnd       data:instant_1936 .

data:instant_1936 a owl:NamedIndividual, time:Instant ;
    time:inXSDgYear "1936"^^xsd:gYear .

# The construction photograph of January 1932
data:interval_1932_01 a owl:NamedIndividual, time:Interval ;
    time:hasBeginning data:instant_1932_01 ;
    time:hasEnd       data:instant_1932_01 .

data:instant_1932_01 a owl:NamedIndividual, time:Instant ;
    time:inXSDgYearMonth "1932-01"^^xsd:gYearMonth .

# The dating given by the Mérimée record (1930 ; 1931)
data:interval_1930_1931 a owl:NamedIndividual, time:Interval ;
    time:hasBeginning data:instant_1930 ;
    time:hasEnd       data:instant_1931 .

data:instant_1930 a owl:NamedIndividual, time:Instant ;
    time:inXSDgYear "1930"^^xsd:gYear .

data:instant_1931 a owl:NamedIndividual, time:Instant ;
    time:inXSDgYear "1931"^^xsd:gYear .

# The street photograph of 28 December 2023
data:interval_2023_12_28 a owl:NamedIndividual, time:Interval ;
    time:hasBeginning data:instant_2023_12_28 ;
    time:hasEnd       data:instant_2023_12_28 .

data:instant_2023_12_28 a owl:NamedIndividual, time:Instant ;
    time:inXSDDate "2023-12-28"^^xsd:date .

# ════════════════════════════════════════════════════════════════════════════
# DOCUMENT 1: aerial view of the Cité des Gratte-Ciel, 1936
#
# Two states (prov:wasRevisionOf):
#   document_1_original  the 1936 photograph, from the Centre du Rize
#                        (Villeurbanne's memory and archives centre)
#   document_1           its digitisation, dated 2020-03-11 15:47:26 by the
#                        file's metadata, published on Wikimedia Commons on
#                        2020-09-28 (CC BY-SA 4.0, credit: Centre du Rize)
# ════════════════════════════════════════════════════════════════════════════

data:document_1_original a owl:NamedIndividual, doc:Document ;
    doc:Document.title "Vue aérienne de la cité des Gratte-Ciel en 1936"@fr ;
    core:AbstractFeatureWithLifespan.creationDate "1936-01-01T00:00:00"^^xsd:dateTime ;
    doc:Document.tag data:tag_gratteCiel, data:tag_aerialView, data:tag_villeurbanne ;
    dct:creator "Centre du Rize Villeurbanne" ;
    rdfs:comment "Original 1936 photograph, from the Centre du Rize, Villeurbanne (source credited on Wikimedia Commons). Year only."@en .

data:document_1 a owl:NamedIndividual, doc:Document ;
    doc:Document.title "Vue aérienne de la cité des Gratte-Ciel en 1936"@fr ;
    doc:Document.uri
        "https://upload.wikimedia.org/wikipedia/commons/a/a8/Vue_a%C3%A9rienne_de_la_cit%C3%A9_des_Gratte-Ciel_en_1936.jpg"^^xsd:anyURI ;
    rdfs:seeAlso
        "https://commons.wikimedia.org/wiki/File:Vue_a%C3%A9rienne_de_la_cit%C3%A9_des_Gratte-Ciel_en_1936.jpg"^^xsd:anyURI ;
    core:AbstractFeatureWithLifespan.creationDate "2020-03-11T15:47:26"^^xsd:dateTime ;
    doc:Document.tag data:tag_gratteCiel, data:tag_aerialView, data:tag_villeurbanne ;
    prov:wasRevisionOf data:document_1_original ;
    dct:creator "Centre du Rize Villeurbanne" ;
    dct:license <https://creativecommons.org/licenses/by-sa/4.0/> ;
    dct:issued "2020-09-28T19:27:42Z"^^xsd:dateTime ;
    rdfs:comment "Digitised photograph; creation date from the file metadata, issued date of its upload to Wikimedia Commons."@en ;
    doc:Document.referringTo
        data:reference_1 ,
        data:reference_2 ,
        data:reference_3 ,
        data:reference_4 ,
        data:reference_5 .

# References 1–4: one per building, as in the DocGraph case study
#     (assertion date of that study: 2020-03-11 15:47:26)
data:reference_1 a owl:NamedIndividual, doc:Reference ;
    doc:Reference.referringDate    "2020-03-11T15:47:26"^^xsd:dateTime ;
